// CityWalk — database schema
// Data model derived from the functional requirements (tables 4.1.1 – 4.1.35),
// extended with end-user accounts and favourites.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RouteCategory {
  HISTORICAL
  NATURE
  ARCHITECTURE
  CULTURE
  FOOD
}

/// Kind of place a stop is, as the route planner classifies it.
enum StopCategory {
  SIGHTSEEING
  FOOD
  ENTERTAINMENT
  NATURE
}

enum RouteStatus {
  DRAFT
  PUBLISHED
}

enum UserRole {
  /// Registered traveller: browses routes and keeps favourites.
  USER
  /// Manages cities, routes and stops (spec 4.1.21 – 4.1.35).
  ADMIN
  /// Additionally manages other administrators. Seeded once, cannot be demoted
  /// by anyone but another super administrator.
  SUPER_ADMIN
}

/// Every account in the system. Travellers and administrators share one table
/// so that authentication has a single code path and a single source of truth.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)

  /// Forces a password change on the next sign-in. Set for seeded accounts,
  /// whose initial password is by definition known to more than one person.
  mustChangePassword Boolean @default(false)

  /// Invalidates every token issued before this moment. Bumped on password
  /// change and on "sign out everywhere".
  tokensValidFrom DateTime @default(now())

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  favorites  Favorite[]
  challenges LoginChallenge[]
  resets     PasswordReset[]
  devices    KnownDevice[]
  savedPlans SavedPlan[]

  @@index([role])
  @@map("users")
}

/// Second step of an administrator sign-in: a six-digit code sent by e-mail.
///
/// The super administrator confirms every sign-in this way; ordinary
/// administrators only when signing in from a device the account has not used
/// before.
model LoginChallenge {
  id     String @id @default(cuid())
  userId String

  /// Hash of the code — never the code itself, so a database leak does not hand
  /// over live second factors.
  codeHash String

  /// Device this challenge was started from, remembered on success.
  deviceHash String?

  attempts  Int       @default(0)
  expiresAt DateTime
  /// Set once the challenge is consumed or burned, making it single-use.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("login_challenges")
}

/// Password recovery code, following the same rules as a login challenge.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_resets")
}

/// A device an administrator has already confirmed with a code.
///
/// The client generates a random identifier and keeps it locally; only its hash
/// reaches the server, so reading this table does not let anyone impersonate a
/// known device.
model KnownDevice {
  id         String   @id @default(cuid())
  userId     String
  deviceHash String
  /// Free-form client hint ("Chrome, Windows"), shown when listing devices.
  label      String   @default("")
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
  @@map("known_devices")
}

/// A route saved by a traveller.
model Favorite {
  userId    String
  routeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  // The pair is the identity of the record: a route can be saved only once.
  @@id([userId, routeId])
  @@index([userId, createdAt])
  @@index([routeId])
  @@map("favorites")
}

/// A city the application offers routes for (spec 4.1.14, 4.1.23 – 4.1.25).
model City {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  country         String
  description     String   @default("")
  coverImageUrl   String?
  centerLatitude  Float
  centerLongitude Float
  defaultZoom     Float    @default(13)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Deleting a city that still has routes is rejected (spec 4.1.25).
  routes     Route[]
  savedPlans SavedPlan[]

  @@index([name])
  @@map("cities")
}

/// A walking route within a city (spec 4.1.2 – 4.1.8, 4.1.26 – 4.1.28, 4.1.35).
model Route {
  id            String        @id @default(cuid())
  slug          String        @unique
  cityId        String
  name          String
  summary       String        @default("")
  description   String        @default("")
  category      RouteCategory
  status        RouteStatus   @default(DRAFT)
  coverImageUrl String?

  /// Statistics derived from the stop sequence, kept denormalised so duration
  /// and distance filters stay a single indexed query (spec 4.1.16).
  distanceMeters  Int @default(0)
  durationMinutes Int @default(0)
  stopCount       Int @default(0)
  /// Sum of the stops' per-person costs, maintained with the other stats.
  costPln         Int @default(0)

  /// Maintained by the favourite endpoints, so the public listing never has to
  /// aggregate the favourites table.
  favoriteCount Int @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  city      City         @relation(fields: [cityId], references: [id], onDelete: Restrict)
  stops     RouteStop[]
  images    RouteImage[]
  favorites Favorite[]

  @@index([status, cityId])
  @@index([status, category])
  @@index([status, durationMinutes])
  @@index([status, distanceMeters])
  @@index([name])
  @@map("routes")
}

/// An ordered point of interest on a route (spec 4.1.5, 4.1.7, 4.1.29 – 4.1.31, 4.1.34).
model RouteStop {
  id          String  @id @default(cuid())
  routeId     String
  position    Int
  name        String
  description String  @default("")
  latitude    Float
  longitude   Float
  imageUrl    String?

  /// Planner metadata: what kind of place it is, what it costs per person
  /// (whole złoty, 0 = free) and how long a visit takes.
  category     StopCategory @default(SIGHTSEEING)
  costPln      Int          @default(0)
  visitMinutes Int          @default(30)
  address      String       @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, position])
  @@index([routeId])
  @@map("route_stops")
}

/// An image attached to a route, stored on an external CDN (spec 4.1.17, 4.1.32, 4.1.33).
model RouteImage {
  id       String @id @default(cuid())
  routeId  String
  url      String
  /// Provider-side identifier, required to delete the asset from the CDN.
  publicId String
  alt      String @default("")
  position Int    @default(0)

  createdAt DateTime @default(now())

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, position])
  @@map("route_images")
}

/// A route built by the planner and kept by a signed-in traveller.
///
/// Only the chosen stops and the request that produced them are stored; the
/// figures are recomputed from the stops when the plan is opened, so they can
/// never disagree with the places themselves.
model SavedPlan {
  id        String   @id @default(cuid())
  userId    String
  cityId    String
  title     String
  /// Interests as requested, including MIXED.
  interests String[]
  budgetPln Int
  people    Int      @default(1)
  /// Stop ids in walking order.
  stopIds   String[]
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("saved_plans")
}
