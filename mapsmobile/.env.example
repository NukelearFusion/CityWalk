# Copy this file to .env and adjust the values.
#
# Only variables prefixed with EXPO_PUBLIC_ are readable from application code.
# They are embedded into the JavaScript bundle in plain text, so never put a
# secret, private key or password here — anything in this file ships to the
# user's device and can be read from the installed app.

# Base URL of the REST API.
# Leave empty (or omit the file entirely) to run against the local fixtures in
# src/api/mock-data.ts.
#
# When pointing at a backend running on your own machine, use the computer's LAN
# address rather than localhost — "localhost" on a phone means the phone itself.
#   EXPO_PUBLIC_API_URL=http://192.168.0.10:4000/api/v1
EXPO_PUBLIC_API_URL=
