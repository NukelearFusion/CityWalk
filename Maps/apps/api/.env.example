# Copy to apps/api/.env and fill in. Never commit the real file.

NODE_ENV=development
PORT=4000

# Local database from docker-compose.yml (`npm run db:up`).
DATABASE_URL=postgresql://citywalk:citywalk_dev@localhost:5433/citywalk

# Session signing key. Generate your own — do not reuse this line:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
SESSION_TTL_HOURS=72

# Browser origins allowed to call the API with cookies. Comma-separated.
# Must never be "*": credentials are sent with every request.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Mailbox receiving the super administrator's sign-in and recovery codes.
# Deliberately not editable from the admin panel.
RECOVERY_EMAIL=admin@example.com

# SMTP transport for one-time codes.
# Leave empty in development: codes are then written to the server console
# instead of being sent. Required in production — the API refuses to start without it.
# For Gmail, use an App Password, not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CityWalk <no-reply@citywalk.app>

# Image hosting. Uploads are rejected with 503 until these are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The first administrator is created with `npm run admin:create` (asks for the
# password interactively). No account credentials belong in this file.
